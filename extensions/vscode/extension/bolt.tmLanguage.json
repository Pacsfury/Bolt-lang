{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bolt",
  "scopeName": "source.blt",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#function-calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.blt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.blt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.blt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.blt",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.blt",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.blt",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.return.blt",
          "match": "\\b(ret|write)\\b"
        },
        {
          "name": "keyword.control.conditional.blt",
          "match": "\\b(if|elseif|else|while|for)\\b"
        },
        {
          "name": "keyword.declaration.blt",
          "match": "\\b(var|const|fn)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.blt",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.blt",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.blt",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "storage.type.blt",
          "match": "\\b(int|char|float|uint|i(8|16|32|64)|u(8|16|32|64)|f(16|32|64))\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.blt",
          "match": "==|!=|<=|>=|\\+|-|\\*|/|=|<|>|\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.delimiter.blt",
          "match": "[(),:;]"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.blt"
            }
          }
        }
      ]
    }
  }
}